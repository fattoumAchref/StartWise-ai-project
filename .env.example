# ============================================================
# LLM Provider — set ONE of the keys below (first found wins)
# ============================================================

# 1. GROQ  — FREE, 6000 req/day, fastest
#    Get key: https://console.groq.com  (gratuit, pas de CB)
#    Install : pip install groq
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant   # optional, this is the default

# 2. Google Gemini  — FREE tier (60 req/min)
#    Get key: https://aistudio.google.com/apikey  (gratuit)
#    Install : pip install google-generativeai
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash     # optional, this is the default

# 3. Ollama  — 100% local, no internet, no API key
#    Install : https://ollama.com  puis: ollama pull llama3.2
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# 4. OpenAI  — payant, utilisé seulement si aucune clé gratuite n'est trouvée
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Autres services
# ============================================================

# Alpha Vantage API key — get a free key at https://www.alphavantage.co
ALPHA_VANTAGE_KEY=your_key_here

# Tavily web search agent — FREE 1000 req/month
#    Get key: https://app.tavily.com  (no credit card required)
#    Install : pip install tavily-python
# TAVILY_API_KEY=tvly-...

# Path to ChromaDB persistent storage (default: ./chroma_db)
CHROMA_PATH=./chroma_db

# ── A2A Message Bus ───────────────────────────────────────────────────────────
# URL du bus A2A (décommenter pour activer la publication automatique)
# Lancer le bus : uvicorn a2a_bus.bus_server:app --port 8765
A2A_BUS_URL=http://localhost:8765
# REDIS_HOST=localhost
# REDIS_PORT=6379
