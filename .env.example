# ============================================================
# StartWise — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ─── LLM Principal (Finance + Investment agents) ─────────────────────────────
ESPRIT_API_KEY=sk-...
ESPRIT_BASE_URL=https://tokenfactory.esprit.tn/api
ESPRIT_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
ESPRIT_VERIFY_SSL=false
TOKEN_FACTORY_API_KEY=sk-...

# ─── Agent Légal (Legal Advisor) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-large

# ─── OpenAI (Idéation + génération d'images) ─────────────────────────────────
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# ─── Communication inter-agents (A2A Bus) ────────────────────────────────────
A2A_BUS_URL=http://localhost:8765
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── Vectorstores ────────────────────────────────────────────────────────────
# ChromaDB (benchmarks finance)
CHROMA_PATH=./chroma_db

# Qdrant (Product Audit + Legal Agent)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Base de données (Agent Légal) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_legal
JWT_SECRET=change-me-in-production

# ─── Idéation — sous-agents ADK ──────────────────────────────────────────────
QUESTION_AGENT_URL=http://localhost:8101
RESEARCH_AGENT_URL=http://localhost:8102
FORMULATOR_AGENT_URL=http://localhost:8103

# Modèles des sous-agents ADK (utilisent LiteLLM).
# Par défaut gpt-4o (OpenAI). Si le quota OpenAI est dépassé, utiliser OpenRouter :
QUESTION_AGENT_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
RESEARCH_AGENT_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
FORMULATOR_AGENT_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
# Timeout HTTP pour les appels A2A (secondes) — réduire pour un fallback plus rapide
A2A_TIMEOUT_SECONDS=20

# ─── Product Audit ───────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
GEMINI_API_KEY=AIza...

# ─── Optionnels ──────────────────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...
# ALPHA_VANTAGE_KEY=your_key_here
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# ─── Sources scraping légal ──────────────────────────────────────────────────
JORT_URL=https://www.legislation.tn
INNORPI_URL=https://www.innorpi.tn
